<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- body: milky translucent fill -->
    <item><shape android:shape="rectangle">
        <corners android:radius="28dp" />
        <gradient android:angle="270" android:startColor="#59FFFFFF" android:endColor="#26FFFFFF" />
    </shape></item>
    <!-- sheen: bright highlight fading down the top half -->
    <item android:bottom="50%"><shape android:shape="rectangle">
        <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
        <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
    </shape></item>
    <!-- rim: thin bright edge like light catching glass -->
    <item><shape android:shape="rectangle">
        <corners android:radius="28dp" />
        <stroke android:width="1.2dp" android:color="#8CFFFFFF" />
    </shape></item>
</layer-list>
